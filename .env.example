# ==============================================================================
# DiaCero — Plantilla de Variables de Entorno (.env.local)
# Copia este archivo como .env.local y completa los valores correspondientes
# ==============================================================================

# Supabase - URL de tu proyecto
NEXT_PUBLIC_SUPABASE_URL=https://<tu-id-de-proyecto>.supabase.co

# Supabase - Clave Pública / Anónima (Uso en frontend y consultas del cliente)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-public-key-aqui

# Supabase - Clave Maestra de Servicio (Uso EXCLUSIVO en backend / API routes)
# Obtenida en: Supabase Dashboard -> Project Settings -> API -> Project API Keys -> service_role (secret)
# Requerida para: creación y reseteo de usuarios, asignación de roles RBAC y bypass RLS controlado
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-secret-key-aqui

# Google Gemini / GenAI - Clave de API para el asistente de IA y resúmenes adaptativos
GOOGLE_GENAI_API_KEY=tu-google-ai-studio-api-key-aqui
